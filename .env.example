# Runtime
NODE_ENV=development
APP_RUNTIME_MODE=server

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
FRONTEND_DIST_DIR=dist
REQUEST_BODY_LIMIT=10mb
USAGE_STATS_TOKEN=

# Banco de dados
DB_PROVIDER=auto
LIBSQL_DB_URL=libsql://YOUR-TURSO-DB.turso.io
LIBSQL_DB_TOKEN=REPLACE_WITH_YOUR_TURSO_TOKEN
SQLITE_DB_FILE=data.sqlite
DATABASE_URL=postgres://svnpedidos:svnpedidos@localhost:5432/svnpedidos
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=150
DB_RETRY_MAX_DELAY_MS=600
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=3000
ALLOW_SQLITE_IN_SERVERLESS=false

# Admin
ADMIN_PASSWORD_HASH=

# Adapter Vercel -> upstream externo
API_UPSTREAM_URL=

# Frontend (Vite)
VITE_PORT=5173
VITE_API_URL=
VITE_LOCAL_API_TARGET=http://localhost:3001
VITE_DEFAULT_ADMIN_PASSWORD=
VITE_DEFAULT_WHATSAPP_NUMBER=
